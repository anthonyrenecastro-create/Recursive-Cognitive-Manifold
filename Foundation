class HalfEdge:
    __slots__ = ['origin', 'twin', 'next', 'face']
    def __init__(self, origin_idx: int):
        self.origin = origin_idx
        self.twin = None
        self.next = None
        self.face = None

class DynamicSimplicialComplex:
    def __init__(self, vertices: np.ndarray, faces: np.ndarray):
        self.vertices = np.pad(vertices, ((0, 0), (0, 1)), mode='constant') if vertices.shape[1] == 2 else vertices
        self.n_vertices = len(self.vertices)
        self.half_edges = {}
        self._current_faces = []
        self._build_half_edge_structure(faces)
        self.L = self.compute_cotangent_laplacian()

    def _build_half_edge_structure(self, faces):
        self.half_edges.clear()
        self._current_faces = [tuple(f) for f in faces]
        for f_idx, face in enumerate(self._current_faces):
            edges = [(face[0], face[1]), (face[1], face[2]), (face[2], face[0])]
            hes = []
            for (u, v) in edges:
                he = HalfEdge(u)
                he.face = f_idx
                self.half_edges[(u, v)] = he
                hes.append(he)
                if (v, u) in self.half_edges:
                    twin_he = self.half_edges[(v, u)]
                    he.twin, twin_he.twin = twin_he, he
            hes[0].next, hes[1].next, hes[2].next = hes[1], hes[2], hes[0]

    def get_faces(self):
        unique_faces = {he.face for he in self.half_edges.values() if he.face is not None}
        return np.array([self._current_faces[i] for i in unique_faces if i < len(self._current_faces)])

    def compute_topology_invariants(self):
        V = self.n_vertices
        E = len({tuple(sorted(k)) for k in self.half_edges.keys()})
        recon_faces = self.get_faces()
        F = len(recon_faces)
        chi = V - E + F

        # BFS for components
        visited = set()
        comps = 0
        for i in range(V):
            if i not in visited:
                comps += 1
                q = deque([i])
                visited.add(i)
                while q:
                    curr = q.popleft()
                    for neighbor in {k[1] for k in self.half_edges.keys() if k[0] == curr}:
                        if neighbor not in visited:
                            visited.add(neighbor)
                            q.append(neighbor)

        return {
            'chi': chi, 'V': V, 'E': E, 'F': F,
            'num_nonmanifold_vertices': len(self._get_nonmanifold_vertices()),
            'num_nonmanifold_edges': len(self._get_nonmanifold_edges()),
            'is_orientable': self._is_orientable(),
            'num_components': comps
        }

    def _get_nonmanifold_edges(self):
        counts = defaultdict(int)
        for u, v in self.half_edges.keys():
            counts[tuple(sorted((u, v)))] += 1
        return [e for e, c in counts.items() if c > 2]

    def _get_nonmanifold_vertices(self):
        nm_verts = []
        for i in range(self.n_vertices):
            outgoing = [he for k, he in self.half_edges.items() if k[0] == i]
            if not outgoing: continue
            rings, visited = 0, set()
            for start_he in outgoing:
                if start_he not in visited:
                    rings += 1
                    curr = start_he
                    while curr and curr not in visited:
                        visited.add(curr)
                        curr = curr.twin.next if (curr.twin and curr.twin.next) else None
                        if curr == start_he: break
            if rings > 1: nm_verts.append(i)
        return nm_verts

    def _is_orientable(self):
        face_orient = {}
        hes = set(self.half_edges.values())
        while hes:
            start = hes.pop()
            if start.face is None: continue
            q = deque([(start, True)])
            while q:
                curr, orient = q.popleft()
                if curr.face is not None:
                    if curr.face in face_orient:
                        if face_orient[curr.face] != orient: return False
                    else:
                        face_orient[curr.face] = orient
                for nxt in [curr.next, curr.next.next]:
                    if nxt in hes:
                        hes.discard(nxt)
                        q.append((nxt, orient))
                if curr.twin and curr.twin in hes:
                    hes.discard(curr.twin)
                    q.append((curr.twin, not orient))
        return True

    def repair_nonmanifold_vertex(self, v_idx):
        outgoing = [he for k, he in self.half_edges.items() if k[0] == v_idx]
        fans = []
        unvisited = set(outgoing)
        while unvisited:
            start = unvisited.pop()
            fan, q = [], deque([start])
            while q:
                curr = q.popleft()
                fan.append(curr)
                nxt = curr.twin.next if (curr.twin and curr.twin.next and curr.twin.next.origin == v_idx) else None
                if nxt in unvisited:
                    unvisited.discard(nxt)
                    q.append(nxt)
            fans.append(fan)

        if len(fans) <= 1: return False
        orig_coords = self.vertices[v_idx].copy()
        for i in range(1, len(fans)):
            new_idx = self.n_vertices
            self.vertices = np.vstack([self.vertices, orig_coords])
            self.n_vertices += 1
            for he in fans[i]:
                f_idx = he.face
                new_f = list(self._current_faces[f_idx])
                for j in range(3):
                    if new_f[j] == v_idx: new_f[j] = new_idx
                self._current_faces[f_idx] = tuple(new_f)
        self._build_half_edge_structure([list(f) for f in self._current_faces])
        return True

    def compute_cotangent_laplacian(self):
        I, J, V_vals = [], [], []
        faces = self.get_faces()
        for f in faces:
            for i_idx in range(3):
                i, j, k = f[i_idx], f[(i_idx+1)%3], f[(i_idx+2)%3]
                vi, vj, vk = self.vertices[i], self.vertices[j], self.vertices[k]
                u, v = vi - vk, vj - vk
                cot = 0.5 * np.dot(u, v) / max(np.linalg.norm(np.cross(u, v)), 1e-12)
                I.extend([i, j, i, j]); J.extend([j, i, i, j]); V_vals.extend([-cot, -cot, cot, cot])
        self.L = coo_matrix((V_vals, (I, J)), shape=(self.n_vertices, self.n_vertices)).tocsr()
        return self.L

    def flip_edge(self, u, v):
        if (u, v) not in self.half_edges: return False
        he = self.half_edges[(u, v)]
        if not he.twin: return False
        w, z = he.next.next.origin, he.twin.next.next.origin
        # Link Condition
        nu = {k[1] for k in self.half_edges.keys() if k[0] == u}
        nv = {k[1] for k in self.half_edges.keys() if k[0] == v}
        if len(nu & nv) != 2: return False
        if (w, z) in self.half_edges or (z, w) in self.half_edges: return False

        # Rewire
        t = he.twin
        hn, hp = he.next, he.next.next
        tn, tp = t.next, t.next.next
        he.origin, t.origin = z, w
        he.next, hp.next, tn.next = hp, tn, he
        t.next, tp.next, hn.next = tp, hn, t
        tn.face, hn.face = he.face, t.face
        del self.half_edges[(u, v)], self.half_edges[(v, u)]
        self.half_edges[(z, w)], self.half_edges[(w, z)] = he, t
        self._current_faces[he.face] = (z, hp.origin, hp.next.origin)
        self._current_faces[t.face] = (w, tp.origin, tp.next.origin)
        return True


@dataclass
class CognitiveNode:
    local_state: np.ndarray
    short_term_memory: deque = field(default_factory=lambda: deque(maxlen=8))
    long_term_memory: deque = field(default_factory=lambda: deque(maxlen=32))
    synchronization_state: float = 0.0
    energy: float = 1.0
    confidence: float = 0.5
    topology_history: deque = field(default_factory=lambda: deque(maxlen=16))
    specialization: str = "undifferentiated"


@dataclass
class CognitiveEdge:
    strength: float = 0.5
    latency: float = 1.0
    resonance: float = 0.0
    age: int = 0
    traversal_frequency: int = 0


@dataclass
class CognitiveRegion:
    node_ids: Tuple[int, ...]
    specialization: str
    activation_trace: deque = field(default_factory=lambda: deque(maxlen=16))
    stability: float = 0.0


class RecursiveCognitiveManifold:
    def __init__(self, state_dim: int = 4, level: int = 0, label: str = "node"):
        self.state_dim = state_dim
        self.level = level
        self.label = label
        self.nodes: Dict[int, CognitiveNode] = {}
        self.edges: Dict[Tuple[int, int], CognitiveEdge] = {}
        self.regions: Dict[Tuple[int, ...], CognitiveRegion] = {}
        self.episodic_memory = deque(maxlen=64)
        self.semantic_memory = defaultdict(int)
        self.structural_memory = deque(maxlen=64)
        self.child_manifolds: List[RecursiveCognitiveManifold] = []
        self.time_step = 0

    @classmethod
    def from_simplicial_complex(cls, complex_: DynamicSimplicialComplex, state_dim: int = 4):
        manifold = cls(state_dim=state_dim, level=0, label="node")
        for node_id in range(complex_.n_vertices):
            coords = complex_.vertices[node_id][:state_dim]
            state = np.zeros(state_dim, dtype=float)
            state[:len(coords)] = coords
            manifold.add_node(node_id, state)

        for u, v in {tuple(sorted(edge)) for edge in complex_.half_edges.keys()}:
            distance = np.linalg.norm(complex_.vertices[u] - complex_.vertices[v])
            manifold.connect(u, v, strength=1.0 / (1.0 + distance), latency=1.0 + distance)
        return manifold

    def add_node(self, node_id: int, local_state: Optional[np.ndarray] = None):
        if local_state is None:
            local_state = np.zeros(self.state_dim, dtype=float)
        self.nodes[node_id] = CognitiveNode(local_state=np.asarray(local_state, dtype=float))

    def connect(self, source: int, target: int, strength: float = 0.5, latency: float = 1.0):
        edge = CognitiveEdge(strength=float(strength), latency=float(latency))
        self.edges[(source, target)] = edge
        self.edges[(target, source)] = CognitiveEdge(strength=edge.strength, latency=edge.latency)
        self._record_topology_event(source, f"link:{source}->{target}")
        self._record_topology_event(target, f"link:{target}->{source}")

    def stimulate(self, node_id: int, signal):
        if node_id not in self.nodes:
            raise KeyError(f"Unknown node_id: {node_id}")
        signal = np.asarray(signal, dtype=float)
        node = self.nodes[node_id]
        node.local_state = self._fit_state(signal)
        node.energy = min(1.5, node.energy + 0.2)
        node.confidence = min(1.0, node.confidence + 0.05)
        node.short_term_memory.append(node.local_state.copy())

    def step(self, external_input: Optional[Dict[int, np.ndarray]] = None):
        if external_input:
            for node_id, signal in external_input.items():
                self.stimulate(node_id, signal)

        updated_states = {}
        edge_usage = defaultdict(int)
        for node_id, node in self.nodes.items():
            incoming = []
            for (source, target), edge in self.edges.items():
                if target != node_id:
                    continue
                source_state = self.nodes[source].local_state
                signal = source_state * edge.strength * (1.0 + edge.resonance)
                incoming.append(signal / edge.latency)
                edge.traversal_frequency += 1
                edge.age += 1
                edge_usage[(source, target)] += 1

            if incoming:
                aggregate = np.mean(incoming, axis=0)
                updated_states[node_id] = 0.6 * node.local_state + 0.4 * aggregate
            else:
                updated_states[node_id] = node.local_state.copy()

        for node_id, new_state in updated_states.items():
            node = self.nodes[node_id]
            node.local_state = new_state
            node.short_term_memory.append(new_state.copy())
            node.energy = float(np.clip(node.energy * 0.97 + np.linalg.norm(new_state) * 0.03, 0.0, 2.0))
            node.confidence = float(np.clip(self._coherence(node.short_term_memory), 0.0, 1.0))

        self._update_episodic_memory()
        self._update_structural_memory(edge_usage)
        self._update_regions()
        self._update_semantic_memory()
        self.time_step += 1
        return self.snapshot()

    def snapshot(self):
        return {
            "level": self.level,
            "label": self.label,
            "time_step": self.time_step,
            "node_count": len(self.nodes),
            "edge_count": len(self.edges),
            "region_count": len(self.regions),
            "episodic_events": len(self.episodic_memory),
            "semantic_motifs": dict(self.semantic_memory),
            "child_manifolds": len(self.child_manifolds),
        }

    def _record_topology_event(self, node_id: int, event: str):
        if node_id in self.nodes:
            self.nodes[node_id].topology_history.append((self.time_step, event))

    def _fit_state(self, signal: np.ndarray) -> np.ndarray:
        state = np.zeros(self.state_dim, dtype=float)
        signal = signal[:self.state_dim]
        state[:len(signal)] = signal
        return state

    def _coherence(self, memory: deque) -> float:
        if len(memory) < 2:
            return 0.5
        stack = np.vstack(memory)
        variance = float(np.mean(np.var(stack, axis=0)))
        return 1.0 / (1.0 + variance)

    def _update_episodic_memory(self):
        episode = {
            "time_step": self.time_step,
            "activations": {node_id: node.local_state.copy() for node_id, node in self.nodes.items()},
            "energy": {node_id: node.energy for node_id, node in self.nodes.items()},
        }
        self.episodic_memory.append(episode)
        for node in self.nodes.values():
            node.long_term_memory.append((self.time_step, node.local_state.copy(), node.energy))

    def _update_structural_memory(self, edge_usage):
        pruned_edges = []
        for (source, target), edge in list(self.edges.items()):
            source_node = self.nodes[source]
            target_node = self.nodes[target]
            similarity = self._state_similarity(source_node.local_state, target_node.local_state)
            edge.resonance = 0.7 * edge.resonance + 0.3 * similarity
            reinforcement = 0.05 * similarity + 0.01 * edge_usage[(source, target)]
            decay = 0.02 if similarity < 0.15 else 0.0
            edge.strength = float(np.clip(edge.strength + reinforcement - decay, 0.0, 2.0))
            if edge.strength < 0.05 and edge.age > 3:
                pruned_edges.append((source, target))

        for edge_key in pruned_edges:
            del self.edges[edge_key]
            self._record_topology_event(edge_key[0], f"prune:{edge_key[0]}->{edge_key[1]}")

        self.structural_memory.append({
            "time_step": self.time_step,
            "edge_strengths": {edge_key: edge.strength for edge_key, edge in self.edges.items()},
            "pruned_edges": pruned_edges,
        })

    def _update_regions(self):
        adjacency = defaultdict(set)
        for source, target in self.edges:
            if self.edges[(source, target)].strength >= 0.25:
                adjacency[source].add(target)

        visited = set()
        regions = {}
        for node_id in self.nodes:
            if node_id in visited:
                continue
            component = []
            queue = deque([node_id])
            visited.add(node_id)
            while queue:
                current = queue.popleft()
                component.append(current)
                for neighbor in adjacency[current]:
                    if neighbor not in visited:
                        visited.add(neighbor)
                        queue.append(neighbor)

            signature = tuple(sorted(component))
            specialization = self._infer_specialization(component)
            region = self.regions.get(signature, CognitiveRegion(signature, specialization))
            region.specialization = specialization
            region.activation_trace.append(self._region_activation(component))
            region.stability = self._coherence(region.activation_trace)
            regions[signature] = region
            for member in component:
                self.nodes[member].specialization = specialization

        self.regions = regions

    def _infer_specialization(self, component: List[int]) -> str:
        if not component:
            return "undifferentiated"
        states = np.vstack([self.nodes[node_id].local_state for node_id in component])
        dominant_axis = int(np.argmax(np.mean(np.abs(states), axis=0)))
        labels = ["sensorimotor", "associative", "predictive", "integrative"]
        return labels[dominant_axis % len(labels)]

    def _region_activation(self, component: List[int]) -> np.ndarray:
        return np.mean([self.nodes[node_id].local_state for node_id in component], axis=0)

    def _update_semantic_memory(self):
        for signature, region in self.regions.items():
            motif = (region.specialization, len(signature), round(region.stability, 2))
            self.semantic_memory[motif] += 1

        stable_regions = [
            signature for signature, region in self.regions.items()
            if len(signature) > 1 and region.stability > 0.85
        ]
        if stable_regions:
            abstracted = self._abstract_regions(stable_regions)
            if self.child_manifolds:
                self.child_manifolds[0] = abstracted
            else:
                self.child_manifolds.append(abstracted)
        else:
            self.child_manifolds.clear()

    def _abstract_regions(self, stable_regions: List[Tuple[int, ...]]):
        meta = RecursiveCognitiveManifold(state_dim=self.state_dim, level=self.level + 1, label=f"meta-{self.label}")
        region_to_meta = {}
        for meta_id, signature in enumerate(stable_regions):
            region = self.regions[signature]
            region_state = self._region_activation(list(signature))
            meta.add_node(meta_id, region_state)
            meta.nodes[meta_id].specialization = region.specialization
            meta.nodes[meta_id].confidence = region.stability
            region_to_meta[signature] = meta_id

        for left, right in combinations(stable_regions, 2):
            coupling = self._cross_region_coupling(left, right)
            if coupling > 0.2:
                meta.connect(region_to_meta[left], region_to_meta[right], strength=coupling, latency=max(0.5, 1.5 - coupling))

        return meta

    def _cross_region_coupling(self, left: Tuple[int, ...], right: Tuple[int, ...]) -> float:
        weights = []
        for source in left:
            for target in right:
                edge = self.edges.get((source, target))
                if edge is not None:
                    weights.append(edge.strength * (1.0 + edge.resonance))
        if not weights:
            return 0.0
        return float(np.mean(weights))

    def _state_similarity(self, left: np.ndarray, right: np.ndarray) -> float:
        left_norm = np.linalg.norm(left)
        right_norm = np.linalg.norm(right)
        if left_norm == 0.0 or right_norm == 0.0:
            return 0.0
        return float(np.dot(left, right) / (left_norm * right_norm))
